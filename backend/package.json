{
  "name": "ledgerline-backend",
  "version": "1.0.0",
  "description": "LedgerLine financial ledger backend",
  "main": "dist/index.js",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js",
    "migrate:dev": "ts-node --transpile-only src/db/migrate.ts",
    "seed:dev": "ts-node --transpile-only src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
    "postgres": "^3.4.4",
    "typescript": "^5.4.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "uuid": "^9.0.1",
    "vitest": "^1.6.0"
  }
}
