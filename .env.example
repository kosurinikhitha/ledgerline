# Copy to backend/.env and edit. backend/.env is gitignored.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline
# The test suite WIPES this database. Its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerline_test
# 32+ characters. Generate your own; do not reuse this one.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Frontend (frontend/.env), only needed when the API is on a different origin (production):
# VITE_API_URL=https://your-api.onrender.com
